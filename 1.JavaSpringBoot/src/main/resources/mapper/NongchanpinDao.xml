<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.cl.dao.NongchanpinDao">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.cl.entity.NongchanpinEntity" id="nongchanpinMap">
        <result property="nongchanpinmingcheng" column="nongchanpinmingcheng"/>
        <result property="tupian" column="tupian"/>
        <result property="chanpinfenlei" column="chanpinfenlei"/>
        <result property="guige" column="guige"/>
        <result property="chuchandi" column="chuchandi"/>
        <result property="baozhiqi" column="baozhiqi"/>
        <result property="shouhuoriqi" column="shouhuoriqi"/>
        <result property="chanpinxiangqing" column="chanpinxiangqing"/>
        <result property="storeupnum" column="storeupnum"/>
        <result property="clicktime" column="clicktime"/>
        <result property="clicknum" column="clicknum"/>
        <result property="groupprice" column="groupprice"/>
